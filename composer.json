{
	"name": "alebarletta7/booking-manager",
	"description": "Gestionale WordPress per B&B, affittacamere, case vacanza, appartamenti e hotel.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=8.1"
	},
	"require-dev": {
		"phpunit/phpunit": "^9.6",
		"yoast/phpunit-polyfills": "^2.0",
		"wp-phpunit/wp-phpunit": "6.6.*",
		"johnpbloch/wordpress-core": "6.6.*"
	},
	"config": {
		"vendor-dir": "vendor",
		"sort-packages": true,
		"platform": {
			"php": "8.1"
		}
	},
	"scripts": {
		"test": "phpunit",
		"test:unit": "phpunit --testsuite unit",
		"test:integration": "phpunit --testsuite integration"
	}
}
